{
  "productName": "Pendy",
  "version": "0.1.0",
  "identifier": "com.pendy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/pendy/",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pendy",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "Pendy.desktop"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "shortDescription": "Personal task management",
    "longDescription": "Pendy is a personal task management app with tasks, habits, projects, labels, recurring tasks, comments, attachments and reminders. Runs as PWA on web and as native app on desktop.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
