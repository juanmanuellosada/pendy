    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp-server"],
      "description": "Live documentation lookup for React, Supabase, Tailwind, date-fns, etc."
    }
  },
  "disabledMcpServers": ["claude.ai Gmail", "claude.ai Google Calendar", "claude.ai Notion"]
}
