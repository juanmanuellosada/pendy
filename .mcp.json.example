{
  "mcpServers": {
    "supabase-pendy": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ynytwbspmqgqwgquxnhf",
      "headers": {
        "Authorization": "Bearer YOUR_SUPABASE_PAT_HERE"
      }
